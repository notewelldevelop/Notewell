{
  "name": "notewell",
  "productName": "NoteWell",
  "version": "1.5.0",
  "description": "Handwritten notes, PDFs and Claude \u2014 for university students. Works offline.",
  "main": "desktop/main.js",
  "author": "NoteWell",
  "license": "MIT",
  "private": true,
  "scripts": {
    "start": "node server/server.js",
    "serve": "node server/server.js",
    "web": "node setup/build-web.js",
    "desktop": "electron .",
    "dist": "electron-builder",
    "dist:mac": "electron-builder --mac",
    "dist:win": "electron-builder --win",
    "dist:linux": "electron-builder --linux",
    "standalone": "node setup/build-standalone.js",
    "vendor": "node setup/fetch-vendor.js",
    "fonts": "node setup/fetch-fonts.js",
    "icons": "python3 setup/make-icons.py",
    "test": "node tests/selftest.mjs && node tests/session.mjs",
    "mobile:add": "npx cap add ios && npx cap add android",
    "mobile:sync": "npx cap sync",
    "mobile:ios": "npx cap open ios",
    "mobile:android": "npx cap open android",
    "release": "node setup/release.js"
  },
  "devDependencies": {
    "electron": "^32.0.0",
    "electron-builder": "^25.0.0"
  },
  "build": {
    "appId": "app.notewell.desktop",
    "productName": "NoteWell",
    "directories": {
      "output": "dist"
    },
    "files": [
      "index.html",
      "manifest.webmanifest",
      "sw.js",
      "css/**/*",
      "js/**/*",
      "icons/**/*",
      "fonts/**/*",
      "vendor/**/*",
      "server/server.js",
      "desktop/**/*"
    ],
    "extraMetadata": {
      "main": "desktop/main.js"
    },
    "mac": {
      "category": "public.app-category.productivity",
      "target": [
        "dmg",
        "zip"
      ],
      "icon": "icons/icon-1024.png"
    },
    "win": {
      "target": [
        "nsis",
        "portable"
      ],
      "icon": "icons/icon-512.png"
    },
    "linux": {
      "target": [
        "AppImage",
        "deb"
      ],
      "category": "Office",
      "icon": "icons/icon-512.png"
    }
  }
}